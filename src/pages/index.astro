---
import Layout from '../layouts/Layout.astro';
---
<Layout title="YouTube Money Calculator - Estimate Ad Revenue by Views and Niche" description="Free YouTube revenue calculator.">
  <style>
    input[type="range"]::-webkit-slider-runnable-track { height: 8px; border-radius: 9999px; background: linear-gradient(to right, #fecaca, #dc2626); }
    input[type="range"]::-moz-range-track { height: 8px; border-radius: 9999px; background: linear-gradient(to right, #fecaca, #dc2626); }
  </style>
  <section class="mb-8">
    <p class="text-gray-600 leading-relaxed" data-i18n="pageDesc"><strong>How much money can you make on YouTube?</strong> Use our free <strong>YouTube Money Calculator</strong> to estimate your ad revenue based on <strong>daily views</strong> and your channel niche RPM.</p>
  </section>
  <section id="calculator">
    <div class="text-center mb-6">
      <h2 class="text-2xl sm:text-3xl font-bold text-gray-800 mb-2" data-i18n="estimatorTitle">Revenue Estimator</h2>
      <p class="text-gray-500 text-sm" data-i18n="estimatorDesc">Adjust views and select your niche.</p>
    </div>
    <div class="bg-gray-50 rounded-lg p-4 border border-gray-200 mb-6">
      <label for="niche" class="block text-sm font-semibold text-gray-700 mb-2" data-i18n="lblNiche">Channel Niche</label>
      <select id="niche" class="w-full px-3 py-2.5 text-sm rounded-lg border border-gray-300 focus:ring-2 focus:ring-red-500 focus:outline-none bg-white">
        <option value="12" data-i18n="nicheFinance">Finance and Investing (RPM $12)</option>
        <option value="10" data-i18n="nicheBusiness">Business and Marketing (RPM $10)</option>
        <option value="8" data-i18n="nicheEducation">Education and How-To (RPM $8)</option>
        <option value="7" data-i18n="nicheHealth">Health and Fitness (RPM $7)</option>
        <option value="7" selected data-i18n="nicheTech">Tech and Gadgets (RPM $7)</option>
        <option value="5" data-i18n="nicheLifestyle">Lifestyle and Vlog (RPM $5)</option>
        <option value="4" data-i18n="nicheCooking">Cooking and Food (RPM $4)</option>
        <option value="3" data-i18n="nicheMusic">Music (RPM $3)</option>
        <option value="2" data-i18n="nicheGaming">Gaming (RPM $2)</option>
        <option value="2" data-i18n="nicheComedy">Comedy and Entertainment (RPM $2)</option>
      </select>
      <p class="text-xs text-gray-400 mt-2" id="rpmDisplay">RPM: $7 / 1,000 views</p>
    </div>
    <div class="bg-gray-50 rounded-lg p-4 border border-gray-200 mb-6">
      <label for="views" class="block text-sm font-semibold text-gray-700 mb-2" data-i18n="lblDailyViews">Daily Views</label>
      <input type="range" id="views" min="100" max="1000000" step="100" value="10000" class="w-full h-2 rounded-lg appearance-none cursor-pointer mt-2 accent-red-600" />
      <div class="flex justify-between mt-2"><span class="text-xs text-gray-400">100</span><span class="text-lg font-bold text-red-600" id="viewsDisplay">10,000 views/day</span><span class="text-xs text-gray-400">1M</span></div>
    </div>
    <div class="bg-gray-50 rounded-lg p-4 border border-gray-200 mb-6">
      <label for="customViews" class="block text-sm font-semibold text-gray-700 mb-2" data-i18n="lblCustomViews">Or enter exact views</label>
      <input type="number" id="customViews" min="1" data-i18n-placeholder="phCustomViews" placeholder="e.g. 50000" class="w-full px-3 py-2.5 text-sm rounded-lg border border-gray-300 focus:ring-2 focus:ring-red-500 focus:outline-none" />
    </div>
    <div id="results">
      <div class="grid sm:grid-cols-3 gap-4 mb-6">
        <div class="bg-gradient-to-br from-red-500 to-red-600 rounded-xl p-5 text-white text-center"><p class="text-sm opacity-80 mb-1" data-i18n="daily">Daily</p><p class="text-3xl font-bold" id="dailyRevenue">$70</p></div>
        <div class="bg-gradient-to-br from-orange-500 to-orange-600 rounded-xl p-5 text-white text-center"><p class="text-sm opacity-80 mb-1" data-i18n="monthly">Monthly</p><p class="text-3xl font-bold" id="monthlyRevenue">$2,100</p></div>
        <div class="bg-gradient-to-br from-amber-500 to-amber-600 rounded-xl p-5 text-white text-center"><p class="text-sm opacity-80 mb-1" data-i18n="yearly">Yearly</p><p class="text-3xl font-bold" id="yearlyRevenue">$25,550</p></div>
      </div>
      <div class="bg-yellow-50 rounded-lg p-4 border border-yellow-200 mb-6">
        <p class="text-sm font-semibold text-yellow-800 mb-2" data-i18n="rangeTitle">Revenue Range (Low - High)</p>
        <div class="grid grid-cols-3 gap-3 text-center text-sm">
          <div><p class="text-xs text-gray-500" data-i18n="daily">Daily</p><p class="font-bold text-yellow-700" id="dailyRange">$35 - $140</p></div>
          <div><p class="text-xs text-gray-500" data-i18n="monthly">Monthly</p><p class="font-bold text-yellow-700" id="monthlyRange">$1,050 - $4,200</p></div>
          <div><p class="text-xs text-gray-500" data-i18n="yearly">Yearly</p><p class="font-bold text-yellow-700" id="yearlyRange">$12.7K - $51.1K</p></div>
        </div>
      </div>
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 mb-6 text-center text-sm">
        <div class="bg-gray-50 rounded-lg p-3"><p class="text-xs text-gray-500 mb-1">RPM</p><p class="font-bold text-gray-800" id="statRpm">$7</p></div>
        <div class="bg-gray-50 rounded-lg p-3"><p class="text-xs text-gray-500 mb-1" data-i18n="dailyViews">Daily Views</p><p class="font-bold text-gray-800" id="statViews">10K</p></div>
        <div class="bg-gray-50 rounded-lg p-3"><p class="text-xs text-gray-500 mb-1" data-i18n="monthlyViews">Monthly Views</p><p class="font-bold text-gray-800" id="statMonthlyViews">300K</p></div>
        <div class="bg-gray-50 rounded-lg p-3"><p class="text-xs text-gray-500 mb-1" data-i18n="cpmEst">CPM Est</p><p class="font-bold text-red-600" id="statCpm">$11</p></div>
      </div>
    </div>
    <div class="bg-amber-50 border border-amber-200 rounded-lg p-4 text-sm text-amber-800">
      <p class="font-semibold mb-1" data-i18n="disclaimer">Disclaimer</p>
      <p class="text-xs" data-i18n="disclaimerD">Estimates only. Actual earnings vary.</p>
    </div>
  </section>
  <section class="mt-10 mb-8">
    <h2 class="text-2xl font-bold text-gray-800 mb-4" data-i18n="howWorksTitle">How YouTube Ad Revenue Works</h2>
    <p class="text-gray-600 text-sm leading-relaxed mb-4" data-i18n="howWorks1">YouTube keeps 45%, creators get <strong>55%</strong>. Earnings measured by <strong>RPM</strong> per 1,000 views.</p>
    <p class="text-gray-600 text-sm leading-relaxed" data-i18n="howWorks2"><strong>Finance channels</strong>: $8-$15 RPM. <strong>Gaming</strong>: $2-$4 RPM.</p>
  </section>
  <section id="faq" class="mb-8">
    <h2 class="text-2xl font-bold text-gray-800 mb-6" data-i18n="faq">FAQ</h2>
    <div class="space-y-4">
      <details class="group bg-gray-50 rounded-lg border border-gray-200 open:bg-white open:shadow-sm"><summary class="cursor-pointer px-4 py-3 font-semibold text-sm" data-i18n="fq1">How much per 1,000 views?</summary><div class="px-4 pb-4 text-sm text-gray-600"><p data-i18n="fa1"><strong>$2-$12 RPM</strong>. Finance $8-$15, gaming $2-$4.</p></div></details>
      <details class="group bg-gray-50 rounded-lg border border-gray-200 open:bg-white open:shadow-sm"><summary class="cursor-pointer px-4 py-3 font-semibold text-sm" data-i18n="fq2">RPM vs CPM?</summary><div class="px-4 pb-4 text-sm text-gray-600"><p data-i18n="fa2"><strong>CPM</strong> = advertiser cost. <strong>RPM</strong> = creator earnings.</p></div></details>
      <details class="group bg-gray-50 rounded-lg border border-gray-200 open:bg-white open:shadow-sm"><summary class="cursor-pointer px-4 py-3 font-semibold text-sm" data-i18n="fq3">Views for $1K/month?</summary><div class="px-4 pb-4 text-sm text-gray-600"><p data-i18n="fa3">At $5 RPM: <strong>200K views/month</strong>. At $10: 100K/month.</p></div></details>
      <details class="group bg-gray-50 rounded-lg border border-gray-200 open:bg-white open:shadow-sm"><summary class="cursor-pointer px-4 py-3 font-semibold text-sm" data-i18n="fq4">Do all views count?</summary><div class="px-4 pb-4 text-sm text-gray-600"><p data-i18n="fa4">Only <strong>monetized playbacks</strong>. 60-80% typically.</p></div></details>
      <details class="group bg-gray-50 rounded-lg border border-gray-200 open:bg-white open:shadow-sm"><summary class="cursor-pointer px-4 py-3 font-semibold text-sm" data-i18n="fq5">Creator share?</summary><div class="px-4 pb-4 text-sm text-gray-600"><p data-i18n="fa5"><strong>55%</strong> to creators, 45% to YouTube.</p></div></details>
    </div>
  </section>
  <script type="application/ld+json" is:inline>{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{"@type":"Question","name":"How much per 1000 views?","acceptedAnswer":{"@type":"Answer","text":"$2-$12 RPM."}}]}</script>
  <script is:inline define:vars={{}}>
    (function(){var niche=document.getElementById("niche"),slider=document.getElementById("views"),custom=document.getElementById("customViews"),vd=document.getElementById("viewsDisplay"),rd=document.getElementById("rpmDisplay");function fmt(n){return n>=1e6?(n/1e6).toFixed(1)+"M":n>=1e3?(n/1e3).toFixed(n>=1e4?0:1)+"K":n.toString();}function money(n){return"$"+Math.round(n).toLocaleString();}function calc(){var t=window._t,rpm=parseFloat(niche.value),views=custom.value?parseInt(custom.value):parseInt(slider.value);if(!views||views<=0)return;vd.textContent=fmt(views)+" "+(t?t("viewsDay"):"views/day");rd.textContent=(t?t("rpmLabel"):"RPM:")+" $"+rpm+" / 1,000 "+(t?t("views"):"views");var daily=(views/1000)*rpm,monthly=daily*30,yearly=daily*365;document.getElementById("dailyRevenue").textContent=money(daily);document.getElementById("monthlyRevenue").textContent=money(monthly);document.getElementById("yearlyRevenue").textContent=money(yearly);var lo=daily*0.5,hi=daily*2;document.getElementById("dailyRange").textContent=money(lo)+" - "+money(hi);document.getElementById("monthlyRange").textContent=money(lo*30)+" - "+money(hi*30);document.getElementById("yearlyRange").textContent=money(lo*365)+" - "+money(hi*365);document.getElementById("statRpm").textContent="$"+rpm;document.getElementById("statViews").textContent=fmt(views);document.getElementById("statMonthlyViews").textContent=fmt(views*30);document.getElementById("statCpm").textContent="$"+Math.round(rpm/0.65);}niche.addEventListener("change",calc);slider.addEventListener("input",function(){custom.value="";calc();});custom.addEventListener("input",calc);window.calculate=calc;calc();})();
  </script>
